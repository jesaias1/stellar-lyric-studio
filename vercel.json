{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"nothing to install\"",
  "buildCommand": "echo \"static site, nothing to build\"",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?p=:path*" }],
  "headers": [{ "source": "/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }]
}
