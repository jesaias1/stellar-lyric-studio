# Copy this file to .dev.vars for local development (npm run dev).
# It is the passcode the studio asks for before it uses the lyric AI.
# The live site uses its own passcode, set with: npx wrangler secret put SLS_PASSCODE
SLS_PASSCODE=choose-a-long-passcode

# Optional, local only: use the real lyric AI instead of the canned sample.
# A Cloudflare account ID and an API token that has "Workers AI" access.
# CF_ACCOUNT_ID=your-cloudflare-account-id
# CF_API_TOKEN=your-workers-ai-api-token

# Optional, local only: real footage and photo search instead of the samples.
# PIXABAY_KEY=your-pixabay-key
# CHARTMETRIC_REFRESH_TOKEN=your-chartmetric-refresh-token   (trending TikTok sounds)
# PEXELS_KEY=your-pexels-key
# SERPAPI_KEY=your-serpapi-key   (Pinterest in the image grabber)
# PINTEREST_APP_ID=...   PINTEREST_APP_SECRET=...   (Connect your Pinterest: your own pins and boards)

# Optional: posting to YouTube, Instagram and TikTok (see the setup guide). Local testing needs the
# http://localhost:8787/api/oauth/... addresses registered with each platform, which TikTok and Instagram refuse
# (they want https), so test those two on the live site.
# TOKEN_KEY=a-long-random-string
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# INSTAGRAM_APP_ID=...
# INSTAGRAM_APP_SECRET=...
# TIKTOK_CLIENT_KEY=...
# TIKTOK_CLIENT_SECRET=...

# Logins (optional locally; without them the passcode above is used)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=sb_publishable_...
