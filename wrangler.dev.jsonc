// Cloudflare settings for Stellar Lyric Studio. Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stellar-lyric-studio-dev",
	// LOCAL DEVELOPMENT ONLY (npm run dev). Never deploy with this file.
	// It has no AI binding, because that needs a live Cloudflare connection. dev/dev-worker.js decides what
	// answers instead: the real Whisper model if .dev.vars has CF_ACCOUNT_ID and CF_API_TOKEN, else a canned sample.
	"main": "dev/dev-worker.js",
	"compatibility_date": "2026-10-27",
	"workers_dev": true,
	"preview_urls": true,
	// The website itself: everything in ./public is served as-is
	"assets": { "directory": "./public" },
	// Shared template library for the team. Off for now: creating the storage needs account-level access on
	// Ana's account. To turn it on, uncomment this line and deploy (the storage is then created automatically).
	"kv_namespaces": [{ "binding": "TEMPLATES" }],
	// A cap of 120 API requests a minute per visitor
	"ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
	"observability": { "enabled": true }
}
